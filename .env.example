# Required on Vercel. Never commit a real key.
OPENAI_API_KEY=

# Cost-efficient default for targeted practice generation.
AI_QUESTION_MODEL=gpt-5.6-luna

# Comma-separated browser origins allowed to call the API.
AI_ALLOWED_ORIGINS=https://alger68.github.io

# Hard output cap per generation request.
AI_MAX_OUTPUT_TOKENS=2400

# Best-effort per-instance cost guard. Add a Vercel Firewall rate-limit rule for global enforcement.
AI_RATE_LIMIT_PER_MINUTE=6
